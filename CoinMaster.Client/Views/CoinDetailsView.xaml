<UserControl
    x:Class="CoinMaster.Client.Views.CoinDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:CoinMaster.Client.ViewModels"
    xmlns:views="clr-namespace:CoinMaster.Client.Views"
    d:DataContext="{d:DesignInstance Type=viewmodels:CoinDetailsViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="900"
    Background="{DynamicResource AppBackgroundBrush}"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,24"
                Orientation="Horizontal">

                <Border
                    Margin="0,0,12,0"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="{Binding Coin.Rank, StringFormat=#{0}}" />
                </Border>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="{Binding Coin.Name}" />

                <TextBlock
                    Margin="12,4,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="{Binding Coin.Symbol}" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Margin="0,0,0,24"
                Padding="24"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{DynamicResource CoinDetails.CurrentPrice}" />
                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="42"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="{Binding Coin.PriceUsd, Converter={StaticResource PriceConverter}}" />

                        <Border
                            Padding="12,0,0,8"
                            VerticalAlignment="Bottom"
                            Background="Transparent">
                            <TextBlock
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{Binding Coin.Change24Hr, Converter={StaticResource PriceColorConverter}}"
                                Text="{Binding Coin.Change24Hr, Converter={StaticResource CompactPercentConverter}}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <UniformGrid
                Grid.Row="2"
                Margin="0,0,0,24"
                Columns="3">

                <Border
                    Margin="0,0,8,0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="{DynamicResource CoinDetails.MarketCap}" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="{Binding Coin.MarketCapUsd, StringFormat=${0:N0}}" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="8,0,8,0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="{DynamicResource CoinDetails.Volume24H}" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="{Binding Coin.VolumeUsd24Hr, StringFormat=${0:N0}}" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="8,0,0,0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="{DynamicResource CoinDetails.MaxSupply}" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}">
                            <TextBlock.Style>

                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Coin.MaxSupply, StringFormat={}{0:N0}}" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Coin.MaxSupply, StringFormat={}{0:N0}}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{DynamicResource CoinDetails.Unlimited}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    MinHeight="280"
                    Margin="0,0,12,0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <DockPanel>

                        <Grid Margin="0,0,0,14" DockPanel.Dock="Top">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="{DynamicResource CoinDetails.PriceChart}" />

                            <ItemsControl HorizontalAlignment="Right" ItemsSource="{Binding Periods}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewmodels:PeriodOption}">
                                        <Border
                                            x:Name="PeriodBorder"
                                            Margin="2,0"
                                            Padding="10,4"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding
                                                    Command="{Binding DataContext.SelectPeriodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    MouseAction="LeftClick" />
                                            </Border.InputBindings>
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="{Binding Label}" />
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.SelectedPeriod" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter TargetName="PeriodBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="PeriodBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <TextBlock
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            DockPanel.Dock="Top"
                            FontSize="13"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="{DynamicResource CoinDetails.Loading}"
                            Visibility="{Binding IsLoadingChart, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Grid>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Candles, Converter={StaticResource EmptyToVisibleConverter}}">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Center"
                                    FontSize="36"
                                    Opacity="0.35"
                                    Text="📈" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="{DynamicResource CoinDetails.NoData}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Opacity="0.7"
                                    Text="{DynamicResource CoinDetails.NoDataMessage}" />
                            </StackPanel>

                            <!--  Chart  -->
                            <views:CandlestickChart
                                MinHeight="220"
                                Candles="{Binding Candles}"
                                Visibility="{Binding Candles, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=invert}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    MinHeight="200"
                    Margin="12,0,0,0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <DockPanel>

                        <TextBlock
                            Margin="0,0,0,12"
                            DockPanel.Dock="Top"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="{DynamicResource CoinDetails.Exchanges}" />

                        <Grid Margin="0,0,0,6" DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="{DynamicResource CoinDetails.Name}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="{DynamicResource CoinDetails.Price}" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="{DynamicResource CoinDetails.Volume}" />
                        </Grid>

                        <Border
                            Height="1"
                            Margin="0,0,0,4"
                            Background="{DynamicResource CardBorderBrush}"
                            DockPanel.Dock="Top" />

                        <Grid>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Coin.Markets, Converter={StaticResource EmptyToVisibleConverter}}">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Center"
                                    FontSize="32"
                                    Opacity="0.35"
                                    Text="🏦" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="{DynamicResource CoinDetails.NoData}" />
                            </StackPanel>

                            <!--  Markets list  -->
                            <ItemsControl ItemsSource="{Binding Coin.Markets}" Visibility="{Binding Coin.Markets, Converter={StaticResource EmptyToVisibleConverter}, ConverterParameter=invert}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="0,7"
                                            BorderBrush="{DynamicResource GridLineBrush}"
                                            BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                                        Text="{Binding ExchangeName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">
                                                        <Run Text="{Binding Base}" /><Run Text="/" /><Run Text="{Binding Target}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource PriceTextBrush}"
                                                    Text="{Binding Price, Converter={StaticResource PriceConverter}}" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    Text="{Binding Volume, Converter={StaticResource CompactConverter}}" />

                                                <Button
                                                    Grid.Column="3"
                                                    Width="20"
                                                    Height="20"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OpenTradeUrl_Click"
                                                    Cursor="Hand"
                                                    Tag="{Binding TradeUrl}"
                                                    ToolTip="{DynamicResource CoinDetails.OpenInExchange}"
                                                    Visibility="{Binding TradeUrl, Converter={StaticResource NullToCollapsedConverter}}">
                                                    <TextBlock
                                                        FontSize="13"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        Text="↗" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                    </DockPanel>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>