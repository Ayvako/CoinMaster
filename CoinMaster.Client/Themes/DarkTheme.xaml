<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Backgrounds  -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D0F14" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#161920" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1C202B" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#1A2540" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#252930" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#1F232E" />

    <!--  Text  -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8ECF5" />
    <SolidColorBrush x:Key="PriceTextBrush" Color="#E8ECF5" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5A6174" />

    <SolidColorBrush x:Key="AccentBrush" Color="#00C2FF" />

    <!--  Chart candles  -->
    <SolidColorBrush x:Key="BullishBrush" Color="#1DB87A" />
    <SolidColorBrush x:Key="BearishBrush" Color="#E84040" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#1F232E" />

    <!--  Column header  -->
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#161920" />
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#5A6174" />

</ResourceDictionary>